#!/usr/bin/env bash
# ramcheck - diagnose RAM usage: processes, swap, GPU GTT, kernel breakdown
#
# ── GTT (Graphics Translation Table) notes ────────────────────────────────────
# GTT is system RAM that the GPU driver (amdgpu) maps into the GPU's address
# space. It doesn't show up in process RSS or /proc/meminfo named fields,
# which makes it appear as "unaccounted" RAM.
#
# Check current GTT limit (in MB; -1 = auto = ~half of system RAM):
#   cat /sys/module/amdgpu/parameters/gttsize
#
# Check current GTT in use per card:
#   cat /sys/class/drm/card1/device/mem_info_gtt_used
#
# To cap GTT (e.g. 8 GB), create a modprobe config and rebuild initramfs:
#   echo "options amdgpu gttsize=8192" | sudo tee /etc/modprobe.d/amdgpu.conf
#   sudo dracut --force
#   sudo reboot
#
# The limit cannot be changed live — amdgpu reads it at module load time.
# Orphaned GTT (from a closed game/app) won't free until logout or reboot.
# Current setting: gttsize=8192 (8 GB), set 2026-04-14.
# ──────────────────────────────────────────────────────────────────────────────

RED='\033[0;31m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'

hr() { printf '%0.s─' $(seq 1 60); echo; }

# ── Overview ──────────────────────────────────────────────────────────────────
echo -e "\n${BOLD}── Memory Overview ──────────────────────────────────────────${RESET}"
date
free -h

# ── Kernel breakdown ──────────────────────────────────────────────────────────
echo -e "\n${BOLD}── Kernel Memory Breakdown ──────────────────────────────────${RESET}"

# Try to read TTM pool directly from debugfs (requires sudo)
_ttm_direct_gb=""
_ttm_raw=$(sudo -n cat /sys/kernel/debug/ttm/page_pool 2>/dev/null)
if [ -n "$_ttm_raw" ]; then
  _ttm_direct_gb=$(printf '%s\n' "$_ttm_raw" | awk '
    /^total[[:space:]]*:/ { pages = $3 }
    END { printf "%.1f", pages * 4 / 1024 / 1024 }
  ')
fi

awk -v ttm_direct="$_ttm_direct_gb" '
/^MemTotal:/      { tot=$2 }
/^MemFree:/       { free=$2 }
/^Buffers:/       { buf=$2 }
/^Cached:/        { cach=$2 }
/^Active:/        { act=$2 }
/^Inactive:/      { inact=$2 }
/^Unevictable:/   { unev=$2 }
/^SReclaimable:/  { srec=$2 }
/^SUnreclaim:/    { sunr=$2 }
/^AnonPages:/     { anon=$2 }
/^KernelStack:/   { kst=$2 }
/^PageTables:/    { pt=$2 }
/^SecPageTables:/ { spt=$2 }
/^VmallocUsed:/   { vmu=$2 }
/^Percpu:/        { cpu=$2 }
/^FileHugePages:/ { fhp=$2 }
/^SwapTotal:/     { stot=$2 }
/^SwapFree:/      { sfree=$2 }
END {
  cache  = (buf + cach + srec)                        / 1024 / 1024
  proc   = anon                                       / 1024 / 1024
  kernel = (sunr + kst + pt + spt + vmu + cpu + fhp) / 1024 / 1024
  lru    = (act + inact + unev)                       / 1024 / 1024
  swap   = (stot - sfree)                             / 1024 / 1024
  printf "  Process anon pages : %6.1f GB  (/proc/meminfo AnonPages — heap, stack, anonymous mmap)\n", proc
  printf "  File cache/buffers : %6.1f GB  (/proc/meminfo Buffers + Cached + SReclaimable)\n", cache
  printf "  Kernel overhead    : %6.1f GB  (SUnreclaim + KernelStack + PageTables + VmallocUsed + Percpu + FileHugePages)\n", kernel
  if (ttm_direct != "") {
    ttm = ttm_direct + 0
    printf "  TTM/driver pool    : %6.1f GB  (/sys/kernel/debug/ttm/page_pool total — GPU driver page pool)\n", ttm
  } else {
    used = (tot - free) / 1024 / 1024
    ttm  = used - lru - kernel
    if (ttm > 1)
      printf "  TTM/driver pool    : %6.1f GB  (residual — run with sudo for direct read)\n", ttm
  }
  printf "  Swap in use        : %6.1f GB  (/proc/meminfo SwapTotal - SwapFree)\n", swap
  accounted = proc + cache + kernel + ttm
  actual    = (tot - free) / 1024 / 1024
  printf "  %-22s %6.1f GB  (sum of above)\n", "Total used:", accounted
  unaccounted = actual - accounted
  if (unaccounted > 0.1)
    printf "  %-22s %6.1f GB  (MemTotal - MemFree = %.1f GB minus sum above)\n", "Unaccounted:", unaccounted, actual
}
' /proc/meminfo

# ── GPU ───────────────────────────────────────────────────────────────────────
echo -e "\n${BOLD}── GPU Memory (amdgpu_top) ───────────────────────────────────${RESET}"
"$(dirname "$0")/gpu_mem_info"

# ── Processes by RAM + swap ───────────────────────────────────────────────────
echo -e "\n${BOLD}── Top Processes by RAM + Swap ───────────────────────────────${RESET}"
printf "  %-10s %-24s %8s %8s %8s\n" "PID" "NAME" "RAM" "SWAP" "TOTAL"
awk '
  FNR == 1 { pid = FILENAME; sub(/\/proc\//, "", pid); sub(/\/.*/, "", pid); rss=0; swap=0; name="" }
  /^Name:/  { name = $2 }
  /^VmRSS:/ { rss  = $2 }
  /^VmSwap:/{ swap = $2; total = rss + swap; if (total > 204800) print pid, name, rss, swap, total }
' /proc/[0-9]*/status 2>/dev/null | sort -k5 -rn | head -20 | \
  awk '
    { printf "  %-10s %-24s %6.0f MB %6.0f MB %6.0f MB\n", $1, $2, $3/1024, $4/1024, $5/1024
      trss += $3; tswap += $4; ttot += $5 }
    END {
      printf "  %s\n", "────────────────────────────────────────────────────────"
      printf "  %-35s %6.0f MB %6.0f MB %6.0f MB\n", "TOTAL (shown above)", trss/1024, tswap/1024, ttot/1024
    }'

echo
